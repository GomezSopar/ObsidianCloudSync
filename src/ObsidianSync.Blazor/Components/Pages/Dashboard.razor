@page "/"
@rendermode InteractiveServer
@inject IVaultRepository VaultRepo
@inject VaultSyncOrchestrator Orchestrator

<PageTitle>Obsidian Sync</PageTitle>

@if (_vault is null)
{
    <div class="spinner-border text-primary" role="status"></div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="card-title mb-1">@_vault.Name</h4>
                <div class="text-muted small">Ruta local: <code>@_vault.LocalPath</code></div>
                <div class="text-muted small">Drive Folder ID: <code>@_vault.RemoteFolderId</code></div>
            </div>
            <div class="text-end">
                <button class="btn btn-primary" @onclick="RunManualSync" disabled="@_isBusy">
                    @(_isBusy ? "Sincronizando..." : "Forzar Sync")
                </button>
                @if (_vault.LastSyncAttemptUtc.HasValue)
                {
                    <div class="small text-muted mt-1">
                        Ultima vez: @_vault.LastSyncAttemptUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_alertMsg))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success")">
            @_alertMsg
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Estado de archivos (@_vault.Files.Count)</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Nota / Archivo</th>
                        <th>Drive ID</th>
                        <th>MD5</th>
                        <th>Sincronizado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_vault.Files.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                Sin archivos registrados todavia. Pulsa "Forzar Sync" para escanear la boveda.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var f in _vault.Files.OrderBy(x => x.RelativePath))
                        {
                            <tr>
                                <td>@f.RelativePath</td>
                                <td><code class="small">@f.RemoteFileId</code></td>
                                <td><code class="small">@f.LastSyncedHash.Value</code></td>
                                <td>@f.LastSyncedUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private Vault? _vault;
    private bool _isBusy;
    private string? _alertMsg;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        _vault = await VaultRepo.GetOrCreateDefaultAsync();
    }

    private async Task RunManualSync()
    {
        if (_vault is null) return;

        _isBusy = true;
        _isError = false;
        _alertMsg = null;

        try
        {
            var res = await Orchestrator.RunSyncAsync(_vault);
            _alertMsg = string.Format("Sync terminado: {0} subidos, {1} bajados, {2} borrados, {3} conflictos.", res.Uploaded, res.Downloaded, res.Deleted, res.Conflicts);
        }
        catch (Exception ex)
        {
            _isError = true;
            _alertMsg = "Error conectando con Drive o leyendo disco: " + ex.Message;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
